SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
ENABLE_DEV_LAB=True

# Dedicated OTP URL from https://console.melipayamak.com/send/otp
# Full URL, or just the token (it is expanded to /api/send/otp/<token>).
# Do not commit the real URL. Pattern/bodyId stay in the console app, not here.
MELIPAYAMAK_API_URL=
MELIPAYAMAK_DRY_RUN=True

# Bale bot from @BotFather. Never commit the real token.
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=killbox_bot
BALE_WEBHOOK_SECRET=
BALE_WEBHOOK_URL=

# Telegram bot from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KillBoxAuthBot
# Cloudflare Worker origin that reverse-proxies https://api.telegram.org
TELEGRAM_API_BASE_URL=https://killbox-telegram.shahin65-haghighi.workers.dev
TELEGRAM_PROXY_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
PUBLIC_SITE_URL=https://killbox.amytisapp.ir
# Shared secret for POST /auth/messenger/claim/ (bot -> site). Never commit the real value.
MESSENGER_CLAIM_SECRET=

# Arvan Object Storage (S3). All user uploads (posts, stories, avatars, banners).
# Template CSS/JS/images stay on the host via WhiteNoise.
# Do not commit real keys. Access/Secret come from panel Access Management.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=killbox-media
AWS_S3_ENDPOINT_URL=https://s3.ir-central1.arvanstorage.ir
AWS_S3_REGION_NAME=ir-central1
AWS_S3_FILE_OVERWRITE=False
AWS_QUERYSTRING_AUTH=False
AWS_S3_CUSTOM_DOMAIN=killbox-media.s3.ir-central1.arvanstorage.ir

# Alliance. REDIS_URL is optional (presence falls back to Django cache).
ALLIANCE_CREATE_MIN_LEVEL=0
ALLIANCE_MAX_MEMBERS=50
ALLIANCE_VOICE_MAX_PARTICIPANTS=50
REDIS_URL=
