SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=
ENABLE_DEV_LAB=True

# Dedicated OTP URL from https://console.melipayamak.com/send/otp
# Full URL, or just the token (it is expanded to /api/send/otp/<token>).
# Do not commit the real URL. Pattern/bodyId stay in the console app, not here.
MELIPAYAMAK_API_URL=
MELIPAYAMAK_DRY_RUN=True

# Bale bot from @BotFather. Never commit the real token.
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=killbox_bot
BALE_WEBHOOK_SECRET=
BALE_WEBHOOK_URL=

# Telegram bot from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KillBoxAuthBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
